# Copy accounts.example.json outside the repository, then point the server to it.
EMAIL_ACCOUNTS_FILE=~/.config/personal-ai-assistant/secrets/email-accounts.json

# Legacy single-Gmail configuration remains supported when EMAIL_ACCOUNTS_FILE is unset:
# GMAIL_CREDENTIALS_FILE=~/.config/personal-ai-assistant/secrets/gmail-credentials.json
# GMAIL_TOKEN_FILE=~/.config/personal-ai-assistant/secrets/gmail-token.json
# MCP_ALLOW_EMAIL_SEND=false
