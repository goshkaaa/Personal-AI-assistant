# Base URL of your Home Assistant instance.
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Prefer a mode-0600 file over putting a long-lived access token in this file.
HOME_ASSISTANT_TOKEN_FILE=~/.config/personal-ai-assistant/secrets/home-assistant-token

# Write tools fail closed until this switch is explicitly enabled.
MCP_ALLOW_HOME_ASSISTANT_WRITE=false
HOME_ASSISTANT_TIMEOUT_SECONDS=15
