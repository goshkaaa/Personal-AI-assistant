# Base URL of your Home Assistant instance.
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Prefer a mode-0600 file over putting a long-lived access token in this file.
HOME_ASSISTANT_TOKEN_FILE=~/.config/personal-ai-assistant/secrets/home-assistant-token

# Write tools fail closed until this switch is explicitly enabled.
MCP_ALLOW_HOME_ASSISTANT_WRITE=false
HOME_ASSISTANT_TIMEOUT_SECONDS=15

# Optional HTTPS reverse geocoder. Coordinates are sent by MCP, never by the model.
# Example: https://nominatim.openstreetmap.org/reverse
HOME_ASSISTANT_REVERSE_GEOCODING_URL=
HOME_ASSISTANT_REVERSE_GEOCODING_LANGUAGE=ru

# Optional private location history. Comma-separate person.* or device_tracker.* IDs.
HOME_ASSISTANT_LOCATION_ENTITIES=
HOME_ASSISTANT_LOCATION_INTERVAL_SECONDS=600
HOME_ASSISTANT_LOCATION_RETENTION_HOURS=72
HOME_ASSISTANT_LOCATION_DB=~/.local/share/personal-ai-assistant/homeassistant/locations.db
