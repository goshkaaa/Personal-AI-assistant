# Apple Account email. Do not put the Apple Account password here.
ICLOUD_USERNAME=you@example.com

# File containing one Apple app-specific password. Keep the file mode at 0600.
ICLOUD_APP_PASSWORD_FILE=~/.config/personal-ai-assistant/secrets/icloud-calendar-password

# Local interpretation and rendering of all-day events and free slots.
CALENDAR_TIMEZONE=Europe/Moscow

# Set this to the opaque id returned by calendar_list_calendars before writes.
CALENDAR_WRITE_CALENDAR_ID=

# Global kill switch. Leave false until reads and the target calendar are verified.
MCP_ALLOW_CALENDAR_WRITE=false

# Prepared write proposals expire quickly and are single-purpose.
CALENDAR_PROPOSAL_TTL_SECONDS=600

# Private local state for idempotency receipts. This contains no credentials.
CALENDAR_STATE_DB=~/.local/share/personal-ai-assistant/calendar.sqlite3
