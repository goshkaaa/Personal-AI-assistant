# Private JSON file containing one or more calendar accounts.
CALENDAR_ACCOUNTS_FILE=~/.config/personal-ai-assistant/secrets/calendar-accounts.json

# Legacy single-account iCloud variables remain supported when CALENDAR_ACCOUNTS_FILE is unset.
# ICLOUD_USERNAME=me@example.com
# ICLOUD_APP_PASSWORD_FILE=~/.config/personal-ai-assistant/secrets/icloud-calendar-password
# CALENDAR_TIMEZONE=Europe/Moscow
# CALENDAR_WRITE_CALENDAR_ID=
# MCP_ALLOW_CALENDAR_WRITE=false
