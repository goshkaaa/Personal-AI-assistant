# Telegram API application credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=hermes_mcp
# Use a separate authorized session for the long-running update listener.
TG_LISTENER_SESSION_NAME=hermes_listener
TG_SESSION_DIR=~/.local/share/personal-ai-assistant/telegram

# MCP HTTP transport. Keep loopback defaults unless a private reverse proxy
# terminates TLS. The bearer token is stored in a chmod-600 file.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp
MCP_RESOURCE_URL=http://127.0.0.1:8765/mcp
MCP_ISSUER_URL=http://127.0.0.1:8765
MCP_TOKEN_FILE=~/.config/personal-ai-assistant/secrets/telegram-mcp-token
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

# Autonomous worker / owner notification process paths.
MCP_SYSTEM_HOME=~
HERMES_PROFILE_NAME=default
HERMES_COMMAND=hermes
HERMES_PROFILE_HOME=~/.hermes/profiles/default
OWNER_DISPLAY_NAME=Owner

MCP_DB_PATH=~/.local/share/personal-ai-assistant/telegram/conversations.db
